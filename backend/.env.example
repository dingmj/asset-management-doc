# 复制为 .env 后按需修改
APP_NAME=资产管理系统
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=asset_db
DATABASE_URL=

SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

JWT_SECRET_KEY=please-change-this-to-a-random-64-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
NORMAL_USERNAME=user
NORMAL_PASSWORD=user123

# ===== 邮件（阶段四）=====
# MAIL_ENABLED=false：开发模拟模式，不真实投递，只写 mail_log +
# 把邮件正文保存到 logs/mail/*.html，方便本地演示
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=asset-system@example.com
MAIL_FROM_NAME=资产管理系统
MAIL_USE_SSL=true
MAIL_TIMEOUT=15
MAIL_DUMP_DIR=logs/mail

# ===== 到期提醒（阶段四）=====
REMIND_DAYS_BEFORE=3
REMIND_TO_ADMIN=true
REMIND_MAIL_ENABLED=true

# ===== 定时任务（阶段四）=====
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
REMIND_CRON_HOUR=9
REMIND_CRON_MINUTE=0
MAIL_RETRY_INTERVAL_MINUTES=30
